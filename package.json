{
  "name": "musie",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "storybook": "pnpm --filter @musie/design-system storybook",
    "build:storybook": "pnpm --filter @musie/design-system build-storybook",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "gen:types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts",
    "db:status": "node scripts/db-status.mjs",
    "db:sync": "node scripts/db-sync.mjs",
    "test": "pnpm -r run test",
    "test:db": "pnpm -r run test:db",
    "test:e2e": "pnpm -r run test:e2e",
    "deck:migration": "pnpm --filter web run deck:migration --",
    "deck:pdf": "pnpm --filter web run deck:pdf --",
    "music:migration": "pnpm --filter web run music:migration --",
    "music:upload": "pnpm --filter web run music:upload --"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "4.136.2"
  }
}
