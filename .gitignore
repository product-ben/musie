node_modules
dist
storybook-static
.env
.env.*
!.env.example

# Playwright's failure artefacts — traces, screenshots and the HTML report.
# Written only when the end-to-end walk fails, and regenerated on every run.
apps/web/test-results/
apps/web/playwright-report/

# The deck's print output — the PDF, the HTML it was printed from, and the bare
# QR svgs from scripts/qr-codes.mjs. Generated, never committed: a print
# artefact that cannot be regenerated is one nobody can check.
deck-print/
qr-codes/

# Per-machine Claude Code permissions. `.claude/settings.json` is shared and
# committed; the `.local` sibling is personal and must never be, or one
# developer's allowlist silently becomes everyone's.
.claude/settings.local.json

# macOS writes one of these into every folder anyone has opened in Finder, and
# five were committed before this line existed — including one under
# `apps/web/public/`, which is copied into the build verbatim and so was served
# to every visitor.
.DS_Store

# VitePress's dependency pre-bundle cache. The site's build output lives at
# apps/docs/.vitepress/dist, which the bare `dist` line above already covers.
.vitepress/cache
.env.local
