{
  "name": "@musie/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Musy design system \u2014 Layer 1 foundations (tokens) + Layer 2 components.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens/musy-fonts.css": "./tokens/musy-fonts.css",
    "./tokens/musy-foundations.css": "./tokens/musy-foundations.css",
    "./tokens/musy-foundations-amendments.css": "./tokens/musy-foundations-amendments.css",
    "./musy-components.css": "./src/musy-components.css",
    "./tokens/theme-init.js": "./tokens/theme-init.js",
    "./tokens/musy-foundations.tokens.json": "./tokens/musy-foundations.tokens.json",
    "./package.json": "./package.json",
    "./tokens/fonts/*": "./tokens/fonts/*"
  },
  "files": [
    "assets",
    "src",
    "tokens",
    "README.md"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && node scripts/verify-tokens.mjs && node scripts/verify-layout.mjs",
    "lint": "eslint .",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "verify:layout": "node scripts/verify-layout.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "lucide-react": "^0.470.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@eslint/js": "^9.17.0",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "lucide-react": "0.470.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "9.1.20",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7"
  }
}
