{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh secret:*)",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(pnpm db:sync:*)",
      "Bash(pnpm db:status:*)",
      "Bash(pnpm gen:types:*)",
      "Bash(pnpm test:db:*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Edit(**/supabase/migrations/**)",
      "Edit(**/supabase/functions/**)",
      "Edit(**/supabase/config.toml)",
      "Edit(**/.github/**)",
      "Edit(**/.claude/settings*)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/wrangler.jsonc)",
      "Edit(**/tools/contributor/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Library/Application Support/ClaudeCode/musie-guard.mjs\" || exit 2"
          }
        ]
      }
    ]
  }
}
