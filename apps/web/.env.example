# Add web-app environment variables here.
# Vite exposes only variables prefixed with VITE_ to browser code.
#
# Copy this file to .env.local and fill in the values. .env.local is ignored
# by git (see the root .gitignore); this file is not, so it must never hold a
# real value.

# For the local stack, `supabase start` prints both of these.
# For a hosted project: Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# The ANON / PUBLISHABLE key, and only that one.
#
# Everything here is compiled into a bundle served to the browser, so this key
# is public the moment it ships. The anon key is designed for that and is
# constrained by row level security.
#
# NEVER put the service role key (or an sb_secret_… key) here. It bypasses RLS
# entirely. src/lib/supabase.ts refuses to start if it finds one, but the guard
# is a backstop, not a permission slip.
VITE_SUPABASE_ANON_KEY=

# ── THE SIGN-IN GATE · H.0b ──────────────────────────────────────────────────
# On, the app will not create an anonymous session: no session means the
# sign-in form, and there is no way past it. Off or unset (the default), the
# app behaves as it always has and the first exercise costs nobody an email
# address.
#
# ON FOR THE BETA. Not because a gate is nicer, but because it is what keeps
# the beta CLOSED — and a closed beta is what keeps a subscription-licensed
# master and a placeholder content set off the open internet while the app sits
# on a real domain. One tester who never finds the sign-in control is that
# argument undone.
#
# Accounts are created by hand and handed out: `node scripts/create-tester.mjs
# someone@example.com`. There is no self-service sign-up and no password reset
# in this build — both need mail (H.1). A forgotten password is reset in the
# Supabase dashboard.
#
# Accepted: true / 1 / on / yes, case-insensitive. Anything else non-empty is
# treated as OFF and warned about in the console, because a flag meant to be on
# that silently parses as off is the failure that matters here.
VITE_REQUIRE_ACCOUNT=false
